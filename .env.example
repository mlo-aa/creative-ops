# Copy to .env.local and fill in values. Never commit .env.local.

# --- Server-only secrets (never expose to the browser) ---

# Anthropic — optional; storyboard generation falls back to mock mode without it
ANTHROPIC_API_KEY=
ANTHROPIC_VIDEO_MODEL=claude-sonnet-4-20250514

# ElevenLabs — voiceover, sound effects, and music generation
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_MUSIC_MODEL_ID=music_v2

# Supabase service role — server-only; full database/storage access
SUPABASE_SERVICE_ROLE_KEY=

# --- Public / client-safe ---

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional app URL for asset resolution in API routes
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Feature flags ---

# Enable local Remotion MP4 render (requires compatible platform + Supabase for upload)
VIDEO_RENDER_ENABLED=false
